# Example only. Never commit real values.
# clipsmith reads credentials from ~/.config/api-keys.env by default; this file
# documents variable names and safe path overrides.

# Credentials (leave blank in the committed example)
TURSO_DB_URL=
TURSO_AUTH_TOKEN_QWSTATS=
CLIPSMITH_DISCORD_TOKEN=
CLIPSMITH_DISCORD_GUILD_ID=
CLIPSMITH_DISCORD_REVIEW_CHANNEL_ID=

# Portable output paths
CLIPSMITH_OUTPUT_ROOT=
CLIPSMITH_STAGE_DIR=
CLIPSMITH_RAW_DIR=
CLIPSMITH_ASSETS_DIR=
CLIPSMITH_FINAL_DIR=
CLIPSMITH_MAP_SOURCE_DIR=
CLIPSMITH_BRAND_SCENES_DIR=
CLIPSMITH_BEATFORGE_DIR=
CLIPSMITH_WSL_STAGE_DIR=

# Deployment. Keep real hostnames in ~/.config/clipsmith-deploy.env.
CLIPSMITH_DEPLOY_DIR=
CLIPSMITH_STATE_DIR=
CLIPSMITH_PINNACLE_SSH=
CLIPSMITH_PINNACLE_REPO=
CLIPSMITH_PINNACLE_DB=
