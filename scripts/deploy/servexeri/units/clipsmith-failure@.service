[Unit]
Description=clipsmith failure hook for %i — journald-visible alert (issue #21)
# Same hook as the pinnacle side; full Discord alerts are issue #31.

[Service]
Type=oneshot
User=@CLIPSMITH_USER@
ExecStart=/bin/sh -c 'echo "CLIPSMITH FAILURE: unit %i failed on $(hostname) at $(date -Is). Inspect: journalctl -u %i -n 100" | systemd-cat -t clipsmith-alert -p err'
